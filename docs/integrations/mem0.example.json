{
  "llm": {
    "provider": "openai",
    "config": {
      "model": "gpt-5-mini",
      "enable_vision": false
    }
  },
  "embedder": {
    "provider": "openai",
    "config": {
      "model": "text-embedding-3-small",
      "embedding_dims": 1536
    }
  },
  "vector_store": {
    "provider": "qdrant",
    "config": {
      "path": "C:/YOUR-CACHE/mem0-vectors",
      "collection_name": "harness_semantic",
      "embedding_model_dims": 1536
    }
  },
  "history_db_path": "C:/YOUR-CACHE/mem0-history.sqlite"
}
